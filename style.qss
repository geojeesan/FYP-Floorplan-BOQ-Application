#thumbnailScrollArea {
    background-color: #f0f0f0; /* Light background for sidebar */
    border: none;
}

#mainViewScrollArea {
    background-color: #3c3c3c; /* Dark gray for main content area */
    border: none;
}

/* Vertical Scrollbar */
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0; /* Default background */
    width: 8px;
    margin: 0px;
}
#mainViewScrollArea QScrollBar:vertical {
    background-color: #3c3c3c; /* Match main view background */
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #aaaaaa;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Horizontal Scrollbar */
QScrollBar:horizontal {
    border: none;
    background-color: #f0f0f0; /* Default background */
    height: 8px;
    margin: 0px;
}
#mainViewScrollArea QScrollBar:horizontal {
    background-color: #3c3c3c; /* Match main view background */
}
QScrollBar::handle:horizontal {
    background-color: #cccccc;
    min-width: 25px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #aaaaaa;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
